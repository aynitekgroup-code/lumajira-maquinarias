{
  "rules": {
    "machines": {
      "$machineId": {
        "sensors": {
          ".read": true,
          ".write": true,
          "sct013": {
            ".indexOn": ["timestamp"]
          },
          "thermistor": {
            ".indexOn": ["timestamp"]
          }
        },
        "commands": {
          ".read": true,
          ".write": true
        },
        "status": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
