{
  "rules": {
    "sensors": {
      "$machineId": {
        ".read": true,
        ".write": true,
        "sct013": {
          ".indexOn": ["timestamp"]
        },
        "thermistor": {
          ".indexOn": ["timestamp"]
        }
      }
    },
    "machines": {
      "$machineId": {
        "status": {
          ".read": true,
          ".write": true
        },
        "commands": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
